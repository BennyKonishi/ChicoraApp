# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# Any long random string — used to sign login sessions.
SESSION_SECRET=fart-poop2-brown-jelkmaster

# Port the server listens on (most hosts set this for you automatically).
PORT=3000

# --- Clash Royale API (https://developer.clashroyale.com) ---
# 1. Create a free account and log in.
# 2. Under "My Account" -> "Create New Key", make a key.
#    IMPORTANT: the key must be locked to the IP address that will actually
#    make the request. See README.md's "Clash Royale API" section — this is
#    the step almost everyone gets stuck on when deploying.
CLASH_ROYALE_API_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzUxMiIsImtpZCI6IjI4YTMxOGY3LTAwMDAtYTFlYi03ZmExLTJjNzQzM2M2Y2NhNSJ9..z2u3BD_ifg91VhjqqK2O9qJOlBd7EuJGB1SOGV_18GDRJ8lQz9YvT8QP_myGGsV-ToMxGCVWoebuaGFuXlBzsQ

# Only needed if your host has no fixed outbound IP address (common on free
# tiers of Render/Railway/etc). Leave blank to use the official API directly.
# If set, whitelist 45.79.218.79 on your key instead of your host's IP.
CLASH_ROYALE_API_BASE=

# Optional: set this once you know it and the app will skip the name search
# (find a clan's tag at https://royaleapi.com — it looks like "#2Y0GC8V0").
CLAN_TAG=#RUVYUJUV

# Only used if CLAN_TAG is blank — the app will search for a clan by this name.
CLAN_NAME=Chicora Goblins
